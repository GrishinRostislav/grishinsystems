# Neon / PostgreSQL Database Connection Strings
POSTGRES_PRISMA_URL="postgresql://user:password@host/database?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host/database?sslmode=require"

# Application Password Protection (leave empty to bypass authentication in local development)
APP_PASSWORD="your_secure_password_here"

# Google Gemini API Key for Receipt Scanning (leave empty to use mock demo scanner)
GEMINI_API_KEY="your_gemini_api_key_here"
