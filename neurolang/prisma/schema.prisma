generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User Profile ───────────────────────────────────────────
model UserProfile {
  id               String         @id @default(uuid()) @db.Uuid
  name             String         @default("New student")
  profileImageUrl  String?
  createdAt        DateTime       @default(now())
  totalXP          Int            @default(0)
  streakCount      Int            @default(0)
  lastPracticeDate DateTime?
  nativeLanguage   String         @default("English")
  targetLanguage   String         @default("Russian")
  languagePairs    LanguagePair[]
}

// ─── Language Pair ──────────────────────────────────────────
model LanguagePair {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  user             UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceLanguage   String      @default("English")
  targetLanguage   String      @default("Russian")
  proficiencyLevel String      @default("A1")
  isActive         Boolean     @default(false)
  createdAt        DateTime    @default(now())
  words            Word[]
  decks            Deck[]
}

// ─── Category ───────────────────────────────────────────────
model Category {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  sortOrder        Int       @default(0)
  isHidden         Boolean   @default(false)
  imageUrl         String?
  fallbackIcon     String?   // system icon name
  createdAt        DateTime  @default(now())

  @@unique([name])
}

// ─── Vocabulary Word ────────────────────────────────────────
model Word {
  id              String        @id @default(uuid()) @db.Uuid
  languagePairId  String        @db.Uuid
  languagePair    LanguagePair  @relation(fields: [languagePairId], references: [id], onDelete: Cascade)
  origin          String
  translate       String
  image           String?
  whenRepeat      DateTime?
  whenAdded       DateTime      @default(now())
  lastRepeat      DateTime?
  wrongAnswer     Int           @default(0)
  rightAnswer     Int           @default(0)
  isLearning      Boolean       @default(false)
  wordPoints      Float         @default(0.0)
  category        String        @default("General")
  reviewAttempts  Int           @default(0)
  reviewSuccesses Int           @default(0)
  lastInterval    Float?
  audioPath       String?
  audioVoiceID    String?
  
  // FSRS fields
  fsrsStability   Float?
  fsrsDifficulty  Float?
  fsrsLastReview  DateTime?
  fsrsState       Int           @default(0) // 0=New, 1=Learning, 2=Review, 3=Relearning

  // Flip Card SRS (Target -> Native)
  flipTNWhenRepeat   DateTime?
  flipTNLastInterval Float?
  flipTNStability    Float?
  flipTNDifficulty   Float?
  flipTNLastReview   DateTime?
  flipTNState        Int        @default(0)
  flipTNRepetition   Int        @default(0)

  // Flip Card SRS (Native -> Target)
  flipNTWhenRepeat   DateTime?
  flipNTLastInterval Float?
  flipNTStability    Float?
  flipNTDifficulty   Float?
  flipNTLastReview   DateTime?
  flipNTState        Int        @default(0)
  flipNTRepetition   Int        @default(0)

  flashcards      Flashcard[]
}

// ─── Deck (Anki-style) ──────────────────────────────────────
model Deck {
  id             String       @id @default(uuid()) @db.Uuid
  languagePairId String       @db.Uuid
  languagePair   LanguagePair @relation(fields: [languagePairId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  flashcards     Flashcard[]
}

// ─── Flashcard ──────────────────────────────────────────────
model Flashcard {
  id             String    @id @default(uuid()) @db.Uuid
  deckId         String    @db.Uuid
  deck           Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  wordId         String?   @db.Uuid
  word           Word?     @relation(fields: [wordId], references: [id], onDelete: SetNull)
  frontText      String
  backText       String
  createdAt      DateTime  @default(now())
  nextReviewDate DateTime  @default(now())
  interval       Int       @default(0)
  repetition     Int       @default(0)
  easinessFactor Float     @default(2.5)
  difficulty     Float     @default(5.0)
  lastReviewDate DateTime?
}

// ─── Daily Quest ────────────────────────────────────────────
model Quest {
  id            String    @id @default(uuid()) @db.Uuid
  questTypeKey  String    // reviewAllWords, learnNewWords, earnXP, etc.
  title         String
  description   String    @default("")
  icon          String    @default("📋")
  xpReward      Int       @default(0)
  targetAmount  Int       @default(0)
  currentAmount Int       @default(0)
  isClaimed     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  questDate     DateTime  @default(now()) // date this quest is for

  @@index([questDate])
}

// ─── Daily Stat (Activity Tracking) ─────────────────────────
model DailyStat {
  id              String    @id @default(uuid()) @db.Uuid
  date            DateTime  @default(now())
  xpEarned        Int       @default(0)
  wordsMastered   Int       @default(0)
  wordsReviewed   Int       @default(0)
  wordsLearned    Int       @default(0)
  practiceMinutes Int       @default(0)

  @@unique([date])
  @@index([date])
}
