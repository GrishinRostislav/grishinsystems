---
layout: base.njk
title: Server Rack Planner - GrishinSystems
description: Interactive 2D server rack planner. Lay out switches, patch panels, power supplies, and routers, and validate ports, power, and space.
---

<link rel="stylesheet" href="/css/rack-planner.css">

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- Full-Viewport App Shell                                    -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div class="ue-app" id="rp-app">
  <!-- ─── Top Menu Bar ─────────────────────────────────────── -->
  <div class="ue-menubar">
    <div class="ue-menu-left">
      <div class="ue-menu-item">
        File
        <div class="ue-dropdown">
          <div class="ue-dropdown-item" id="menu-file-print">🖨️ Print Manifest</div>
          <div class="ue-dropdown-item danger" id="menu-file-clear">✕ Clear Rack</div>
        </div>
      </div>
      <div class="ue-menu-item">
        View
        <div class="ue-dropdown">
          <div class="ue-dropdown-item" data-toggle-window="catalog">✓ Components</div>
          <div class="ue-dropdown-item" data-toggle-window="settings">✓ Project Settings</div>
          <div class="ue-dropdown-item" data-toggle-window="endpoints">✓ PoE Endpoints</div>
          <div class="ue-dropdown-item" data-toggle-window="validation">✓ Validation</div>
          <div class="ue-dropdown-item" data-toggle-window="bom">  Bill of Materials</div>
        </div>
      </div>
      <div class="ue-menu-item">
        Help
        <div class="ue-dropdown">
          <div class="ue-dropdown-item" id="menu-help-about">About Rack Planner</div>
        </div>
      </div>
    </div>

    <div class="ue-menu-center">
      <span class="ue-toolbar-title">Rack Planner 2D</span>
      <select id="input-rack-size" class="ue-toolbar-select">
        <option value="9">9U</option>
        <option value="12">12U</option>
        <option value="18" selected>18U</option>
        <option value="24">24U</option>
        <option value="42">42U</option>
      </select>
    </div>

    <div class="ue-menu-right">
      <span class="ue-status-chip" id="status-space">📦 0U / 18U</span>
      <span class="ue-status-chip" id="status-ports">🔌 0 Ports</span>
      <span class="ue-status-chip" id="status-poe">⚡ 0W PoE</span>
      <span class="ue-status-chip" id="status-cost">💰 $0</span>
    </div>
  </div>

  <!-- ─── Desktop Area ─────────────────────────────────────── -->
  <div class="ue-desktop" id="ue-desktop">
    
    <!-- Viewport (Canvas Background) -->
    <div class="ue-viewport rp-canvas" id="rp-canvas">
      <div class="rp-canvas-content" id="rp-canvas-content">
        <div class="cabinet-wrapper">
          <div class="cabinet-rack" id="cabinet-rack">
            <!-- Rendered dynamically by JS -->
          </div>
        </div>
      </div>
    </div>

    <!-- Viewport Zoom Controls -->
    <div class="ue-viewport-zoom">
      <button class="rp-zoom-btn" id="zoom-out" title="Zoom Out">−</button>
      <input type="range" id="zoom-slider" class="rp-zoom-slider" min="25" max="200" value="100" step="5">
      <button class="rp-zoom-btn" id="zoom-in" title="Zoom In">+</button>
      <span class="rp-zoom-label" id="zoom-label">100%</span>
      <button class="rp-zoom-btn" id="zoom-fit" title="Fit to View">⊡</button>
    </div>

    <!-- WINDOW: Catalog -->
    <div class="ue-window" id="win-catalog" data-window="catalog" style="width:280px; height:600px; left:20px; top:20px; display:flex;">
      <div class="ue-window-header">
        <span class="ue-window-title">Components</span>
        <button class="ue-window-close">✕</button>
      </div>
      <div class="ue-window-content rp-sidebar">
        <div class="rp-sidebar-head" style="padding-bottom: 8px;">
          <button id="btn-add-custom" class="rp-btn-sm" style="width:100%;">+ Custom Device</button>
        </div>
        <div class="rp-search-wrap">
          <input type="text" id="catalog-search" class="rp-search-input" placeholder="Search equipment…" autocomplete="off">
          <button id="catalog-search-clear" class="rp-search-clear" style="display:none;">✕</button>
        </div>
        <div class="catalog-tabs" id="catalog-tabs">
          <button class="catalog-tab active" data-tab="switches">Switches</button>
          <button class="catalog-tab" data-tab="panels">Panels</button>
          <button class="catalog-tab" data-tab="routers">Routers</button>
          <button class="catalog-tab" data-tab="power">Power</button>
          <button class="catalog-tab" data-tab="theater">Theater</button>
          <button class="catalog-tab" data-tab="sources">Sources</button>
          <button class="catalog-tab" data-tab="misc">Misc</button>
        </div>
        <div class="catalog-list" id="catalog-list">
          <!-- Dynamically populated via JS -->
        </div>
      </div>
      <div class="ue-resize-handle"></div>
    </div>

    <!-- WINDOW: Settings -->
    <div class="ue-window" id="win-settings" data-window="settings" style="width:280px; height:auto; right:20px; top:20px; display:flex;">
      <div class="ue-window-header">
        <span class="ue-window-title">Project Settings</span>
        <button class="ue-window-close">✕</button>
      </div>
      <div class="ue-window-content rp-panel" style="border:none; border-radius:0; box-shadow:none; margin:0;">
        <div class="rp-settings-grid">
          <div class="rp-setting">
            <label for="input-drops">Wall Ports</label>
            <input type="number" id="input-drops" min="0" max="240" value="12">
          </div>
          <div class="rp-setting">
            <label for="input-local-links">Local Lines</label>
            <input type="number" id="input-local-links" min="0" max="48" value="2">
          </div>
        </div>
      </div>
      <div class="ue-resize-handle"></div>
    </div>

    <!-- WINDOW: PoE Endpoints -->
    <div class="ue-window" id="win-endpoints" data-window="endpoints" style="width:340px; height:300px; right:20px; top:120px; display:flex;">
      <div class="ue-window-header">
        <span class="ue-window-title">PoE Endpoints</span>
        <button class="ue-window-close">✕</button>
      </div>
      <div class="ue-window-content rp-panel" style="border:none; border-radius:0; box-shadow:none; margin:0; display:flex; flex-direction:column; height:100%;">
        <div style="padding: 12px; padding-bottom: 0;">
          <button type="button" class="rp-btn-full" id="btn-open-endpoint-modal">+ Add Endpoint</button>
        </div>
        <div class="endpoint-list-wrapper" style="flex:1;">
          <table class="endpoint-table" id="endpoint-table">
            <thead>
              <tr>
                <th style="width:22px;"></th>
                <th>Model</th>
                <th style="text-align:center;width:50px;">Type</th>
                <th style="text-align:center;width:32px;">Qty</th>
                <th style="text-align:right;width:50px;">W</th>
                <th style="text-align:right;width:28px;"></th>
              </tr>
            </thead>
            <tbody id="endpoint-list-body">
              <!-- Dynamically populated via JS -->
            </tbody>
          </table>
        </div>
      </div>
      <div class="ue-resize-handle"></div>
    </div>

    <!-- WINDOW: Validation -->
    <div class="ue-window" id="win-validation" data-window="validation" style="width:280px; height:auto; right:20px; top:450px; display:flex;">
      <div class="ue-window-header">
        <span class="ue-window-title">Validation</span>
        <button class="ue-window-close">✕</button>
      </div>
      <div class="ue-window-content rp-panel" style="border:none; border-radius:0; box-shadow:none; margin:0;">
        <div class="rp-val-list">
          <div class="rp-val-item validation-card valid" id="val-space">
            <span class="rp-val-dot"></span>
            <span class="validation-icon">📦</span>
            <span class="validation-name">Rack Space</span>
            <span class="validation-value">0U / 18U</span>
          </div>
          <div class="rp-val-item validation-card valid" id="val-switch-ports">
            <span class="rp-val-dot"></span>
            <span class="validation-icon">🔌</span>
            <span class="validation-name">Switch Ports</span>
            <span class="validation-value">0 / 24</span>
          </div>
          <div class="rp-val-item validation-card valid" id="val-patch-ports">
            <span class="rp-val-dot"></span>
            <span class="validation-icon">🎛️</span>
            <span class="validation-name">Patch Panels</span>
            <span class="validation-value">0 / 24</span>
          </div>
          <div class="rp-val-item validation-card valid" id="val-poe">
            <span class="rp-val-dot"></span>
            <span class="validation-icon">⚡</span>
            <span class="validation-name">PoE Load</span>
            <span class="validation-value">0W / 0W</span>
          </div>
          <div class="rp-val-item validation-card valid" id="val-outlets">
            <span class="rp-val-dot"></span>
            <span class="validation-icon">🔌</span>
            <span class="validation-name">Outlets</span>
            <span class="validation-value">0 / 0</span>
          </div>
        </div>
      </div>
      <div class="ue-resize-handle"></div>
    </div>

    <!-- WINDOW: BOM Manifest -->
    <div class="ue-window" id="win-bom" data-window="bom" style="width:600px; height:300px; left:320px; bottom:20px; display:none;">
      <div class="ue-window-header">
        <span class="ue-window-title">Bill of Materials &amp; Manifest</span>
        <button class="ue-window-close">✕</button>
      </div>
      <div class="ue-window-content" style="display:flex; flex-direction:column; height:100%; background:#0a0f1a;">
        <div class="manifest-grid" style="height:100%;">
          <div class="manifest-table-wrapper" style="height:100%; overflow:auto;">
            <table class="manifest-table">
              <thead>
                <tr>
                  <th id="th-type" class="sortable" style="cursor:pointer;user-select:none;">Type <span class="sort-icon"></span></th>
                  <th id="th-name" class="sortable" style="cursor:pointer;user-select:none;">Device <span class="sort-icon"></span></th>
                  <th id="th-qty" class="sortable" style="cursor:pointer;user-select:none;text-align:center;width:80px;">Qty <span class="sort-icon"></span></th>
                  <th id="th-cost" class="sortable" style="cursor:pointer;user-select:none;text-align:right;width:100px;">Cost <span class="sort-icon"></span></th>
                </tr>
              </thead>
              <tbody id="manifest-body">
                <!-- Dynamically populated via JS -->
              </tbody>
            </table>
          </div>
          <div class="manifest-summary-card">
            <h3>Specifications</h3>
            <div class="summary-row"><span>U Space:</span><span id="manifest-u-count" style="font-weight:700;">0U / 18U</span></div>
            <div class="summary-row"><span>Switch Ports:</span><span id="manifest-port-count" style="font-weight:700;">0</span></div>
            <div class="summary-row"><span>PoE Budget:</span><span id="manifest-poe-budget" style="font-weight:700;">0W</span></div>
            <div class="summary-row"><span>PDU/UPS Plugs:</span><span id="manifest-outlet-count" style="font-weight:700;">0</span></div>
            <div class="summary-row total"><span>Est. Cost:</span><span id="manifest-total-cost" style="color:var(--accent-cyan);">$0</span></div>
          </div>
        </div>
      </div>
      <div class="ue-resize-handle"></div>
    </div>

  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- Modals (same structure, just repositioned after .rp-app)   -->
<!-- ═══════════════════════════════════════════════════════════ -->

<!-- Add Custom/Generic Device Overlay Modal -->
<div class="modal-overlay" id="custom-device-modal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Add Custom Hardware</h3>
      <button class="modal-close" id="modal-close">✕</button>
    </div>
    <form id="custom-device-form">
      <div class="form-group" style="margin-bottom:12px;">
        <label for="custom-name">Device Model Name</label>
        <input type="text" id="custom-name" placeholder="e.g. Ubiquiti USW-Lite-16-PoE" required>
      </div>
      <div class="form-grid" style="margin-bottom:12px;">
        <div class="form-group">
          <label for="custom-brand">Brand Style</label>
          <select id="custom-brand">
            <option value="generic">Generic Slate</option>
            <option value="ubiquiti">Ubiquiti Blue</option>
            <option value="cisco">Cisco Green</option>
            <option value="mikrotik">MikroTik Amber</option>
            <option value="cyberpower">CyberPower Yellow</option>
            <option value="tplink">TP-Link Turquoise</option>
            <option value="araknis">Araknis Blue</option>
          </select>
        </div>
        <div class="form-group">
          <label for="custom-type">Equipment Type</label>
          <select id="custom-type">
            <option value="switch">Ethernet Switch</option>
            <option value="patch-panel">Patch Panel</option>
            <option value="router">Router / Firewall</option>
            <option value="power">UPS / PDU Power</option>
            <option value="misc" selected>Shelf / Cable Organizer</option>
          </select>
        </div>
      </div>
      <div class="form-group" style="margin-bottom:12px;">
        <label for="custom-target-slot">Mount Position (U Slot)</label>
        <select id="custom-target-slot" required></select>
      </div>
      <div class="form-grid" style="margin-bottom:12px;">
        <div class="form-group">
          <label for="custom-u">Height (U)</label>
          <select id="custom-u">
            <option value="1" selected>1U</option>
            <option value="2">2U</option>
            <option value="3">3U</option>
            <option value="4">4U</option>
          </select>
        </div>
        <div class="form-group">
          <label for="custom-cost">Est. Price ($)</label>
          <input type="number" id="custom-cost" min="0" value="100">
        </div>
      </div>
      <div class="form-grid" style="margin-bottom:16px;">
        <div class="form-group">
          <label for="custom-ports">Ports (RJ45)</label>
          <input type="number" id="custom-ports" min="0" value="0">
        </div>
        <div class="form-group">
          <label for="custom-poe-ports">PoE Ports</label>
          <input type="number" id="custom-poe-ports" min="0" value="0">
        </div>
      </div>
      <div class="form-grid" style="margin-bottom:16px;">
        <div class="form-group">
          <label for="custom-poe-budget">PoE Budget (W)</label>
          <input type="number" id="custom-poe-budget" min="0" value="0">
        </div>
        <div class="form-group">
          <label for="custom-outlets">Power Outlets</label>
          <input type="number" id="custom-outlets" min="0" value="0">
        </div>
      </div>
      <div class="form-group" style="flex-direction:row;gap:8px;align-items:center;margin-bottom:20px;">
        <input type="checkbox" id="custom-power" checked style="width:auto;">
        <label for="custom-power" style="cursor:pointer;text-transform:none;font-size:14px;color:var(--text);">Requires AC Power</label>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;padding:12px;">Add Device to Cabinet</button>
    </form>
  </div>
</div>

<!-- Add PoE Endpoint Overlay Modal -->
<div class="modal-overlay" id="endpoint-device-modal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Add PoE Endpoint Device</h3>
      <button class="modal-close" id="modal-endpoint-close">✕</button>
    </div>
    <form id="endpoint-device-form">
      <div class="form-group" style="margin-bottom:16px;">
        <label for="endpoint-category">Device Category</label>
        <select id="endpoint-category" style="width:100%;">
          <option value="wireless">Wi-Fi &amp; Bridges</option>
          <option value="cctv" selected>IP CCTV Cameras</option>
          <option value="access">Access Control &amp; Doorbells</option>
          <option value="voip">VoIP Phones &amp; Displays</option>
        </select>
      </div>
      <div class="form-group" style="margin-bottom:16px;">
        <label for="endpoint-search">Filter Models</label>
        <input type="text" id="endpoint-search" placeholder="Type to filter…" autocomplete="off">
      </div>
      <div class="form-group" style="margin-bottom:16px;">
        <label for="endpoint-model">Select Model</label>
        <select id="endpoint-model" style="width:100%;"></select>
      </div>
      <div class="form-group" style="margin-bottom:24px;">
        <label for="endpoint-qty">Quantity</label>
        <input type="number" id="endpoint-qty" min="1" max="96" value="4" style="width:100%;" required>
      </div>
      <button type="submit" class="btn btn-primary" id="btn-add-endpoint" style="width:100%;justify-content:center;padding:12px;font-weight:700;">Add to Project</button>
    </form>
  </div>
</div>

<script src="/js/rack-planner.js"></script>
