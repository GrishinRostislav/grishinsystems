---
layout: base.njk
---

<section class="blog-post" style="padding-top: 140px; padding-bottom: 80px;">
  <div class="container" style="max-width: 800px;">
    <div style="margin-bottom: 40px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--glass-border);">
        <a href="/" style="color: var(--text-muted); font-size: 14px; text-decoration: none; display: flex; align-items: center; gap: 6px; transition: var(--transition);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">
          <span style="font-size: 18px;">←</span> Back to Home
        </a>
        <a href="/blog/" class="btn btn-secondary btn-sm" style="background: rgba(10,22,40,0.4); font-weight: 500;">
          📋 All Articles
        </a>
      </div>
      <h1 style="font-size: clamp(32px, 4vw, 48px); margin: 20px 0 10px; line-height: 1.2;">{{ title }}</h1>
      <div style="color: var(--text-secondary); font-size: 14px; display: flex; gap: 16px;">
        <span>📅 {{ date | readableDate }}</span>
        {% if tags %}
          <span style="color: var(--accent);">
            {% for tag in tags %}
              {% if tag != "post" %}#{{ tag }} {% endif %}
            {% endfor %}
          </span>
        {% endif %}
      </div>
    </div>
    
    <div class="post-content" style="font-size: 17px; line-height: 1.8; color: var(--text-secondary);">
      {{ content | safe }}
    </div>

    <div style="margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--glass-border); text-align: center;">
      <a href="/blog/" class="btn btn-secondary">← Back to All Articles</a>
    </div>
  </div>
</section>

<style>
/* Markdown Content Styling */
.post-content h2 { color: var(--text); font-size: 28px; margin: 40px 0 20px; font-weight: 700; }
.post-content h3 { color: var(--text); font-size: 22px; margin: 30px 0 15px; font-weight: 600; }
.post-content p { margin-bottom: 24px; }
.post-content ul, .post-content ol { margin-bottom: 24px; padding-left: 24px; }
.post-content li { margin-bottom: 10px; }
.post-content code { background: rgba(10, 22, 40, 0.8); padding: 3px 6px; border-radius: 4px; font-family: 'Courier New', monospace; font-size: 0.9em; color: var(--accent-cyan); border: 1px solid var(--glass-border); }
.post-content pre { background: rgba(10, 22, 40, 0.8); padding: 20px; border-radius: var(--radius-sm); overflow-x: auto; margin-bottom: 24px; border: 1px solid var(--glass-border); }
.post-content pre code { background: transparent; padding: 0; border: none; color: var(--text); }
.post-content blockquote { border-left: 4px solid var(--accent); padding-left: 20px; margin-left: 0; color: var(--text-muted); font-style: italic; }
.post-content a { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
.post-content img { max-width: 100%; border-radius: var(--radius-sm); border: 1px solid var(--glass-border); margin: 24px 0; }
</style>
