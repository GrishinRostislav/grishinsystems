---
layout: base.njk
---

<!-- HERO -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-grid"></div>
  <div class="container">
    <div class="hero-content">
      <div class="hero-badge"><span class="pulse"></span> Open to Opportunities</div>
      <h1>Rostislav Grishin</h1>
      <div class="subtitle">Network & Infrastructure Specialist</div>
      <p>I design, deploy, and manage enterprise network environments. 13+ years of building reliable, secure infrastructure — from single offices to 120+ distributed locations.</p>
      <div class="hero-ctas">
        <a href="#contact" class="btn btn-primary btn-lg">Get In Touch</a>
        <a href="#projects" class="btn btn-secondary btn-lg">View My Work</a>
      </div>
      <div class="hero-stats">
        <div class="hero-stat"><span class="num">13+</span><span class="lbl">Years Experience</span></div>
        <div class="hero-stat"><span class="num">120+</span><span class="lbl">Locations Managed</span></div>
        <div class="hero-stat"><span class="num">99.9%</span><span class="lbl">Uptime Target</span></div>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-terminal">
        <div class="terminal-header"><div class="terminal-dot"></div><div class="terminal-dot"></div><div class="terminal-dot"></div></div>
        <div class="terminal-line"><span class="prompt">rostislav@grishinsystems:~$</span> <span class="cmd">whoami</span></div>
        <div class="terminal-line"><span class="output">Network & Infrastructure Specialist</span></div>
        <div class="terminal-line"><span class="prompt">rostislav@grishinsystems:~$</span> <span class="cmd">cat skills.conf</span></div>
        <div class="terminal-line"><span class="comment"># Core Stack</span></div>
        <div class="terminal-line"><span class="output">Cisco Meraki | VLANs | VPN | L2/L3</span></div>
        <div class="terminal-line"><span class="output">OSPF | STP | DHCP | DNS | NAT</span></div>
        <div class="terminal-line"><span class="output">Zero-Trust | Wireshark | Nmap</span></div>
        <div class="terminal-line"><span class="prompt">rostislav@grishinsystems:~$</span> <span class="cmd">uptime</span></div>
        <div class="terminal-line"><span class="output">13 years, 0 days of downtime-free ops</span></div>
        <div class="terminal-line"><span class="prompt">rostislav@grishinsystems:~$</span> <span class="terminal-cursor"></span></div>
      </div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section id="about">
  <div class="container">
    <div class="about-grid">
      <div class="network-anim-container">
        <!-- Connecting lines -->
        <svg class="net-lines" viewBox="0 0 320 320" xmlns="http://www.w3.org/2000/svg">
          <line x1="160" y1="160" x2="160" y2="0" stroke="rgba(148,163,184,0.15)" stroke-width="2" />
          <line x1="160" y1="160" x2="295" y2="65" stroke="rgba(148,163,184,0.15)" stroke-width="2" />
          <line x1="160" y1="160" x2="295" y2="255" stroke="rgba(148,163,184,0.15)" stroke-width="2" />
          <line x1="160" y1="160" x2="160" y2="320" stroke="rgba(148,163,184,0.15)" stroke-width="2" />
          <line x1="160" y1="160" x2="25" y2="255" stroke="rgba(148,163,184,0.15)" stroke-width="2" />
          <line x1="160" y1="160" x2="25" y2="65" stroke="rgba(148,163,184,0.15)" stroke-width="2" />
        </svg>

        <div class="net-core"><span style="font-family: 'Courier New', monospace; font-size: 32px; font-weight: 800; color: #fff;">&gt;_</span></div>
        <div class="net-node n1"><span class="icon">☁️</span><span class="label">Cloud</span></div>
        <div class="net-node n2"><span class="icon">🏢</span><span class="label">VPN</span></div>
        <div class="net-node n3"><span class="icon">🖥️</span><span class="label">Servers</span></div>
        <div class="net-node n4"><span class="icon">📹</span><span class="label">CCTV</span></div>
        <div class="net-node n5"><span class="icon">🔌</span><span class="label">IoT</span></div>
        <div class="net-node n6"><span class="icon">🏠</span><span class="label">Smart</span></div>
        
        <!-- Data Packets -->
        <div class="packet p1"></div>
        <div class="packet p2"></div>
        <div class="packet p3"></div>
        <div class="packet p4"></div>
        <div class="packet p5"></div>
        <div class="packet p6"></div>
        <div class="packet p7"></div>
        <div class="packet p8"></div>
        <div class="packet p9"></div>
        <div class="packet p10"></div>
        <div class="packet p11"></div>
        <div class="packet p12"></div>
      </div>
      <div class="about-text fade-in">
        <h3>Building Networks That Just Work</h3>
        <p>I'm an Infrastructure & Network Specialist based in Edmonton, Alberta with over 13 years of hands-on experience designing and managing complex L2/L3 network environments across both IT and OT systems.</p>
        <p>My expertise lies in enterprise networking — VLAN segmentation, VPN architecture, and cloud-managed infrastructure. I've managed connectivity for 120+ distributed locations using Cisco Meraki, achieving 99.9% uptime with standardized, well-documented deployments.</p>
        <p>Currently advancing toward my CCNA certification and looking for <strong>remote or hybrid network engineering opportunities</strong> where I can bring my experience with enterprise-scale infrastructure.</p>
        <div class="about-highlights">
          <span class="tag">🇨🇦 Edmonton, AB</span>
          <span class="tag tag-green">✓ Open to Remote</span>
          <span class="tag">🎓 M.Eng Telecom</span>
          <span class="tag tag-amber">📚 CCNA In Progress</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- EXPERTISE -->
<section id="expertise">
  <div class="container">
    <div class="section-header fade-in">
      <div class="section-label">What I Do Best</div>
      <h2 class="section-title">Core Expertise</h2>
      <p class="section-subtitle">Focused on enterprise networking, security, and infrastructure — not general IT support.</p>
    </div>
    <div class="expertise-grid">
      <div class="glass-card expertise-card fade-in">
        <div class="expertise-icon">🌐</div>
        <h3>Network Architecture</h3>
        <p>Designing robust L2/L3 network topologies for enterprise and multi-site environments with high availability.</p>
        <div class="expertise-tags"><span class="tag">TCP/IP</span><span class="tag">OSPF</span><span class="tag">STP</span><span class="tag">Subnetting</span></div>
      </div>
      <div class="glass-card expertise-card fade-in">
        <div class="expertise-icon">☁️</div>
        <h3>Cloud-Managed Networks</h3>
        <p>Deploying and managing 120+ locations via Cisco Meraki dashboard with centralized monitoring and 98% config consistency.</p>
        <div class="expertise-tags"><span class="tag">Cisco Meraki</span><span class="tag">Ubiquiti</span><span class="tag">Aruba</span></div>
      </div>
      <div class="glass-card expertise-card fade-in">
        <div class="expertise-icon">🔒</div>
        <h3>VPN & Security</h3>
        <p>Engineering Site-to-Site and Client VPN tunnels for secure remote management of distributed automation systems.</p>
        <div class="expertise-tags"><span class="tag">S2S VPN</span><span class="tag">Cisco ASA</span><span class="tag">Fortinet</span><span class="tag">ACLs</span></div>
      </div>
      <div class="glass-card expertise-card fade-in">
        <div class="expertise-icon">🛡️</div>
        <h3>VLAN & Zero Trust</h3>
        <p>Strategic network segmentation isolating OT, CCTV, and security systems with zero-trust communication principles.</p>
        <div class="expertise-tags"><span class="tag">VLANs</span><span class="tag">802.1Q</span><span class="tag">NAT</span><span class="tag">Zero-Trust</span></div>
      </div>
      <div class="glass-card expertise-card fade-in">
        <div class="expertise-icon">🔧</div>
        <h3>Troubleshooting & Analysis</h3>
        <p>Deep-packet analysis and systematic debugging across heterogeneous environments. L1-L3 issue resolution.</p>
        <div class="expertise-tags"><span class="tag">Wireshark</span><span class="tag">Nmap</span><span class="tag">Traceroute</span></div>
      </div>
      <div class="glass-card expertise-card fade-in">
        <div class="expertise-icon">📐</div>
        <h3>Infrastructure & Documentation</h3>
        <p>Rack design, structured cabling, UPS/PDU systems. Comprehensive As-Built documentation and topology diagrams.</p>
        <div class="expertise-tags"><span class="tag">Visio</span><span class="tag">As-Built</span><span class="tag">Cable Mgmt</span></div>
      </div>
    </div>
  </div>
</section>

<!-- PROJECTS -->
<section id="projects" style="background:linear-gradient(180deg,var(--primary-light),var(--primary))">
  <div class="container">
    <div class="section-header fade-in">
      <div class="section-label">Selected Work</div>
      <h2 class="section-title">Project Highlights</h2>
      <p class="section-subtitle">Real results from real deployments. Details anonymized for confidentiality.</p>
    </div>
    <div class="projects-grid">
      <div class="glass-card project-card fade-in">
        <div class="project-header"><span class="project-number">01</span><span class="tag tag-green">Cloud-Managed</span></div>
        <h3>120+ Location Network Rollout</h3>
        <p>Scaled and maintained a distributed network infrastructure using Cisco Meraki, ensuring centralized management and 98% configuration consistency across all sites.</p>
        <div class="project-metrics">
          <div class="metric"><span class="val">120+</span><span class="lbl">Locations</span></div>
          <div class="metric"><span class="val">98%</span><span class="lbl">Config Consistency</span></div>
          <div class="metric"><span class="val">99.9%</span><span class="lbl">Uptime</span></div>
        </div>
      </div>
      <div class="glass-card project-card fade-in">
        <div class="project-header"><span class="project-number">02</span><span class="tag tag-amber">Security</span></div>
        <h3>Zero-Trust OT/IT Segmentation</h3>
        <p>Designed L2/L3 segmentation using VLANs to isolate OT, CCTV, and security systems. Implemented zero-trust communication across 100+ distributed nodes.</p>
        <div class="project-metrics">
          <div class="metric"><span class="val">100+</span><span class="lbl">Nodes</span></div>
          <div class="metric"><span class="val">5</span><span class="lbl">VLAN Zones</span></div>
          <div class="metric"><span class="val">0</span><span class="lbl">Breaches</span></div>
        </div>
      </div>
      <div class="glass-card project-card fade-in">
        <div class="project-header"><span class="project-number">03</span><span class="tag">Enterprise</span></div>
        <h3>Multi-Site VPN Infrastructure</h3>
        <p>Engineered Site-to-Site and Client VPN tunnels enabling encrypted remote management of distributed systems across multiple geographic regions.</p>
        <div class="project-metrics">
          <div class="metric"><span class="val">S2S</span><span class="lbl">VPN Type</span></div>
          <div class="metric"><span class="val">24/7</span><span class="lbl">Remote Access</span></div>
          <div class="metric"><span class="val">AES-256</span><span class="lbl">Encryption</span></div>
        </div>
      </div>
      <div class="glass-card project-card fade-in">
        <div class="project-header"><span class="project-number">04</span><span class="tag tag-green">Documentation</span></div>
        <h3>Infrastructure Standardization</h3>
        <p>Developed standardized network templates for switches and APs, reducing deployment time by 40%. Created comprehensive As-Built documentation for all sites.</p>
        <div class="project-metrics">
          <div class="metric"><span class="val">40%</span><span class="lbl">Faster Deploy</span></div>
          <div class="metric"><span class="val">70+</span><span class="lbl">Projects</span></div>
          <div class="metric"><span class="val">Full</span><span class="lbl">As-Built Docs</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- BLOG -->
<section id="blog">
  <div class="container">
    <div class="section-header fade-in">
      <div class="section-label">Knowledge Sharing</div>
      <h2 class="section-title">Latest Articles</h2>
      <p class="section-subtitle">Writing about networking, infrastructure, and my CCNA journey.</p>
    </div>
    <div class="blog-grid">
      {%- for post in collections.post | reverse -%}
        {%- if loop.index0 < 3 -%}
        <a href="{{ post.url }}" class="glass-card blog-card fade-in" style="display: block; text-decoration: none; color: inherit;">
          <div class="blog-date">📅 {{ post.date | readableDate }}</div>
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.description }}</p>
          <span class="read-more">Read Article →</span>
        </a>
        {%- endif -%}
      {%- else -%}
        <div class="glass-card blog-card fade-in">
          <div class="blog-date">📅 Coming Soon</div>
          <h3>Managing 120+ Locations with Cisco Meraki: Lessons Learned</h3>
          <p>Real-world insights from deploying and maintaining a cloud-managed network across hundreds of distributed sites.</p>
          <span class="read-more">Read Article →</span>
        </div>
        <div class="glass-card blog-card fade-in">
          <div class="blog-date">📅 Coming Soon</div>
          <h3>VLAN Segmentation for OT/IT Networks: A Practical Guide</h3>
          <p>How to properly isolate operational technology systems from your corporate network using VLANs and zero-trust principles.</p>
          <span class="read-more">Read Article →</span>
        </div>
        <div class="glass-card blog-card fade-in">
          <div class="blog-date">📅 Coming Soon</div>
          <h3>My CCNA Journey: Study Plan & Progress</h3>
          <p>Documenting my path to CCNA certification — study resources, lab setups, and the concepts that matter most.</p>
          <span class="read-more">Read Article →</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- CERTIFICATIONS -->
<section id="certs" style="background:linear-gradient(180deg,var(--primary-light),var(--primary))">
  <div class="container">
    <div class="section-header fade-in">
      <div class="section-label">Education & Certifications</div>
      <h2 class="section-title">Credentials</h2>
    </div>
    <div class="certs-grid">
      <div class="glass-card cert-card fade-in">
        <span class="cert-icon">🎓</span>
        <h3>Master of Engineering</h3>
        <div class="cert-org">Telecommunications</div>
        <p>Almaty University of Power Engineering and Telecommunications · 2010 – 2012</p>
      </div>
      <div class="glass-card cert-card fade-in">
        <span class="cert-icon">🎓</span>
        <h3>Bachelor of Engineering</h3>
        <div class="cert-org">Telecommunications</div>
        <p>Almaty University of Power Engineering and Telecommunications · 2006 – 2010</p>
      </div>
      <div class="glass-card cert-card fade-in">
        <span class="cert-icon">📜</span>
        <h3>CCNA</h3>
        <div class="cert-org">Cisco · In Progress — Expected 2026</div>
        <p>VLANs, OSPF, STP, IPv4/IPv6, ACLs, DHCP, NAT, Port Security</p>
        <div class="progress-bar"><div class="progress-fill" style="width:70%"></div></div>
      </div>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section class="contact" id="contact">
  <div class="container">
    <div class="section-header fade-in">
      <div class="section-label">Get In Touch</div>
      <h2 class="section-title">Let's Work Together</h2>
      <p class="section-subtitle">Open to full-time, contract, or consulting opportunities in network engineering.</p>
    </div>
    <div class="contact-grid">
      <div class="contact-info fade-in">
        <h3>Ready to Connect</h3>
        <p>Whether you're looking for a network engineer, need a consultation, or want to collaborate on a project — I'd love to hear from you.</p>
        <div class="contact-item"><div class="contact-item-icon">✉️</div><div><h4>Email</h4><a href="mailto:ross@grishinsystems.com">ross@grishinsystems.com</a></div></div>
        <div class="contact-item"><div class="contact-item-icon">💼</div><div><h4>LinkedIn</h4><a href="https://linkedin.com/in/rostislav-grishin" target="_blank">linkedin.com/in/rostislav-grishin</a></div></div>
        <div class="contact-item"><div class="contact-item-icon">📍</div><div><h4>Location</h4><p>Edmonton, AB, Canada</p></div></div>
        <div class="contact-item"><div class="contact-item-icon">🌐</div><div><h4>Availability</h4><p>Remote · Hybrid · On-site (Edmonton area)</p></div></div>
      </div>
      <form class="contact-form fade-in" id="contact-form">
        <div class="form-row">
          <div class="form-group"><label for="name">Name</label><input type="text" id="name" placeholder="Your name" required></div>
          <div class="form-group"><label for="email">Email</label><input type="email" id="email" placeholder="you@company.com" required></div>
        </div>
        <div class="form-group">
          <label for="subject">Subject</label>
          <select id="subject"><option value="">Select...</option><option>Job Opportunity</option><option>Freelance / Consulting</option><option>Collaboration</option><option>General Inquiry</option></select>
        </div>
        <div class="form-group"><label for="message">Message</label><textarea id="message" placeholder="Tell me about the opportunity or project..."></textarea></div>
        <button type="submit" class="btn btn-primary btn-lg" style="width:100%;justify-content:center;">Send Message</button>
      </form>
    </div>
  </div>
</section>
