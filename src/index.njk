<!-- BLOG -->
<section id="blog" class="section-grid">
  <div class="container">
    <div class="section-header fade-in">
      <div class="section-label">Knowledge Sharing</div>
      <h2 class="section-title">Latest Articles</h2>
      <p class="section-subtitle">Writing about networking, infrastructure, and real-world IT lessons.</p>
    </div>
    <div class="blog-grid">
      {%- for post in collections.post | reverse -%}
        {%- if loop.index0 < 3 -%}
        <a href="{{ post.url }}" class="glass-card blog-card fade-in" style="display: block; text-decoration: none; color: inherit;">
          <div class="blog-date">📅 {{ post.date | readableDate }}</div>
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.description }}</p>
          <span class="read-more">Read Article →</span>
        </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div style="text-align: center; margin-top: 48px;">
      <a href="/blog/" class="btn btn-primary">View All Articles</a>
    </div>
  </div>
</section>

